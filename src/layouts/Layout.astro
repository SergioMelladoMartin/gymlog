---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import SideNav from '../components/SideNav';
import SyncStatus from '../components/SyncStatus';
import Onboarding from '../components/Onboarding';
import UIHost from '../components/ui/UIHost';

interface Props {
  title?: string;
  activeNav?: 'today' | 'calendar' | 'diary' | 'stats' | 'exercises' | 'login';
}

const { title = 'gymlog', activeNav = 'today' } = Astro.props;

const navTitle = {
  today: 'Hoy',
  calendar: 'Calendario',
  diary: 'Diario',
  exercises: 'Ejercicios',
  stats: 'Estadísticas',
  login: 'Acceso',
}[activeNav];

// i18n key mirroring the above so the client script below can swap the text
// to English without a reload when the stored language is 'en'. Server-side
// render always shows the Spanish default (no FOUC on the common case).
const navTitleKey = {
  today: 'nav.today',
  calendar: 'nav.calendar',
  diary: 'nav.diary',
  exercises: 'nav.exercises',
  stats: 'nav.stats',
  login: 'nav.login',
}[activeNav];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0f0f15" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="gymlog" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline data-astro-rerun>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute('data-theme', stored || (sysDark ? 'dark' : 'light'));
          var accent = localStorage.getItem('accent');
          if (accent && accent !== 'lime') document.documentElement.setAttribute('data-accent', accent);
          // Apply the persisted "collapsed sidebar" preference before paint.
          var collapsed = localStorage.getItem('sidenav-collapsed') === '1';
          if (collapsed) document.body && document.body.classList.add('sidenav-collapsed');
          // body may not exist yet during <head>; the class is also applied
          // inline below as a fallback through the data attribute.
          window.__gymlogSidenavCollapsed = collapsed;
        } catch (e) {}
      })();
    </script>
    <script is:inline data-astro-rerun>
      // Swap the nav title to the stored language, client-side only, using
      // the same dictionaries as src/lib/i18n.ts (kept inline so this runs
      // before the React islands hydrate, avoiding a flash of Spanish→English).
      (function () {
        try {
          var lang = localStorage.getItem('gymlog-lang');
          if (lang !== 'en') return;
          var EN = {
            'nav.today': 'Today', 'nav.calendar': 'Calendar', 'nav.diary': 'Diary',
            'nav.exercises': 'Exercises', 'nav.stats': 'Stats', 'nav.login': 'Sign in',
          };
          var el = document.querySelector('[data-navtitle-key]');
          var key = el && el.getAttribute('data-navtitle-key');
          if (el && key && EN[key]) el.textContent = EN[key];
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body class="min-h-dvh" data-sidenav={activeNav !== 'login' ? '' : undefined}>
    <div id="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <script is:inline>
      // Drive the top navigation progress bar from ClientRouter lifecycle
      // events. Bound once on first load — ClientRouter keeps the same
      // document across navigations, so these document-level listeners
      // persist (this script is NOT marked data-astro-rerun on purpose).
      (function () {
        var bar = document.getElementById('nav-progress');
        if (!bar || bar.dataset.bound) return;
        bar.dataset.bound = '1';
        var hideTimer;
        function start() {
          clearTimeout(hideTimer);
          bar.classList.remove('done');
          // force reflow so the transition restarts from 0 each navigation
          void bar.offsetWidth;
          bar.classList.add('loading');
        }
        function done() {
          bar.classList.remove('loading');
          bar.classList.add('done');
          hideTimer = setTimeout(function () { bar.classList.remove('done'); }, 400);
        }
        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', done);
      })();
    </script>
    <script is:inline>
      // Apply the collapsed-sidebar class on body (the head script ran before
      // body existed). Idempotent across Astro client-side navigations.
      try {
        if (window.__gymlogSidenavCollapsed) document.body.classList.add('sidenav-collapsed');
        else document.body.classList.remove('sidenav-collapsed');
      } catch (e) {}
    </script>
    {activeNav !== 'login' && <SideNav client:load transition:persist="sidenav" active={activeNav} />}
    <header class="glass-bar sticky top-0 z-30 border-b border-border/60">
      <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 py-3">
        {activeNav !== 'login' && (
          <button
            type="button"
            class="grid h-9 w-9 place-items-center rounded-lg border border-border bg-elevated/60 text-fg transition hover:bg-elevated lg:hidden"
            aria-label="Abrir menú"
            onclick="window.dispatchEvent(new CustomEvent('gymlog:open-sidenav'))"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" x2="20" y1="6" y2="6" />
              <line x1="4" x2="20" y1="12" y2="12" />
              <line x1="4" x2="20" y1="18" y2="18" />
            </svg>
          </button>
        )}
        <div class="flex min-w-0 flex-1 items-center gap-2">
          <a href="/" class="btn-accent accent-glow grid h-8 w-8 shrink-0 place-items-center rounded-lg" aria-label="Ir a Hoy">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.4 14.4 9.6 9.6" />
              <path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z" />
              <path d="m21.5 21.5-1.4-1.4" />
              <path d="M3.9 3.9 2.5 2.5" />
              <path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z" />
            </svg>
          </a>
          <span class="truncate text-[15px] font-semibold tracking-tight" data-navtitle-key={navTitleKey}>{navTitle}</span>
        </div>
        {activeNav !== 'login' && <SyncStatus client:only="react" transition:persist="sync-status" />}
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-6" transition:animate={fade({ duration: '0.2s' })}>
      <slot />
    </main>
    {activeNav !== 'login' && <Onboarding client:only="react" />}
    <UIHost client:only="react" transition:persist="ui-host" />
  </body>
</html>
