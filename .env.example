# Google OAuth client ID (public — exposed to the browser). Same value the
# app already used before WP1.
PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Google OAuth client secret. Server-only, never exposed to the browser.
# Get it from Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_SECRET=

# Random key (>=32 bytes, base64) used to derive the AES-256-GCM key that
# encrypts the refresh token cookie. Generate one with:
#   openssl rand -base64 32
AUTH_COOKIE_SECRET=
